# Copy to .env.local (git-ignored). All values are public client config - never put secrets here.

# RevenueCat PUBLIC iOS SDK key (starts with appl_). Without it, production builds show purchases as unavailable.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Preview/dev only: simulate purchases locally. Must be false/absent in production.
EXPO_PUBLIC_ENABLE_MOCK_PURCHASES=false

# Dosing page. Disabled in the production EAS profile because of App Store Guideline 1.4.1 (see docs/APP_STORE.md).
EXPO_PUBLIC_ENABLE_MEDICINE_DOSES=true

# Hosted legal pages and support contact shown in Settings/Paywall
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
