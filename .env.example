# Copy to .env.local (git-ignored). All values are public client config - never put secrets here.

# RevenueCat PUBLIC iOS SDK key (starts with appl_). Without it, production builds show purchases as unavailable.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Preview/dev only: simulate purchases locally. Must be false/absent in production.
EXPO_PUBLIC_ENABLE_MOCK_PURCHASES=false

# Hosted legal pages and support contact shown in Settings/Paywall
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Parent picks and Best by age: your affiliate link for each product (https only).
# Leave blank to link to the brand's own page. The button says "(affiliate link)" only when one is set.
EXPO_PUBLIC_AFFILIATE_HALO_SLEEPSACK_SWADDLE=
EXPO_PUBLIC_AFFILIATE_HALO_SLEEPSACK_WEARABLE=
EXPO_PUBLIC_AFFILIATE_DRBRONNERS_BABY_UNSCENTED=
EXPO_PUBLIC_AFFILIATE_DOJO_FOAM_SOAP=
EXPO_PUBLIC_AFFILIATE_DRBROWNS_OPTIONS_BOTTLE=
EXPO_PUBLIC_AFFILIATE_CHICCO_KEYFIT_30=
EXPO_PUBLIC_AFFILIATE_GRACO_EXTEND2FIT=
EXPO_PUBLIC_AFFILIATE_LOVEVERY_PLAY_GYM=
EXPO_PUBLIC_AFFILIATE_SOPHIE_LA_GIRAFE=
EXPO_PUBLIC_AFFILIATE_FP_ROCK_A_STACK=
EXPO_PUBLIC_AFFILIATE_IKEA_ANTILOP=
EXPO_PUBLIC_AFFILIATE_EZPZ_TINY_CUP=
EXPO_PUBLIC_AFFILIATE_EZPZ_MINI_MAT=
EXPO_PUBLIC_AFFILIATE_HAPE_POUND_AND_TAP_BENCH=
EXPO_PUBLIC_AFFILIATE_LEGO_DUPLO_BRICK_BOX=
EXPO_PUBLIC_AFFILIATE_STRIDER_12_SPORT=
