{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENABLE_MOCK_PURCHASES": "true" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ENABLE_MOCK_PURCHASES": "true" }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_MOCK_PURCHASES": "false"
      }
    }
  },
  "submit": { "production": {} }
}
